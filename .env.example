# Copy to .env and fill in. NEVER commit .env.
# See SECRETS.md for GitHub Actions secret names.

EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=Windstar Tahiti Price Tracker <onboarding@resend.dev>

# Resend free-tier testing: redirect ALL mail to SANDBOX_INBOX with a banner
# EMAIL_SANDBOX=1  or  NODE_ENV=development
EMAIL_SANDBOX=1
NODE_ENV=development
SANDBOX_INBOX=you@example.com

# Personalized drop alerts: email:FirstName,email:FirstName,...
ALERT_RECIPIENTS=you@example.com:You,family@example.com:Family
ALERT_EMAIL=you@example.com
INTRO_CC_EMAIL=you@example.com

DEPARTURE_DATE=2027-05-20
DASHBOARD_URL=http://127.0.0.1:8765/

CHECK_INTERVAL_MINUTES=60
HOST=127.0.0.1
PORT=8765
CRON_SECRET=
DISABLE_LOCAL_SCHEDULER=0

# Required if the app is reachable from the internet (e.g. via a tunnel) —
# HTTP Basic Auth password gating the whole site. Leave blank to disable
# (only safe for strictly localhost-only use).
SITE_PASSWORD=

PERX_USERNAME=
PERX_PASSWORD=
ID90_EMAIL=
ID90_PASSWORD=

# Optional overrides for seed script / cloud
# ID90_CRUISE_URL=
# PERX_CRUISE_URL=
